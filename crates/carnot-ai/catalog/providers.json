{
  "schema_version": 1,
  "providers": {
    "anthropic": {
      "api": "anthropic-messages",
      "aliases": ["claude"],
      "description": "Anthropic Messages API (Claude 4.x / 5.x, direct x-api-key or Bearer gateway)",
      "base_url": "https://api.anthropic.com",
      "base_url_envs": ["ANTHROPIC_BASE_URL"],
      "default_model": "claude-sonnet-5-5",
      "auth_chain": [
        { "scheme": "bearer", "env": "ANTHROPIC_AUTH_TOKEN" },
        { "scheme": "x-api-key", "env": "ANTHROPIC_API_KEY" },
        { "scheme": "oauth" }
      ],
      "headers": {
        "anthropic-version": "2023-06-01"
      },
      "betas": [],
      "cache_diagnosis_beta": "cache-diagnosis-2026-04-07",
      "native_tool_search": true,
      "compat": {
        "supports_prompt_cache_key": false,
        "supports_eager_input_streaming": true,
        "requires_thinking_signature": true,
        "supports_native_web_search": true,
        "supports_native_web_fetch": true,
        "native_web_fetch_beta": "web-fetch-2025-09-10"
      }
    },
    "openai": {
      "api": "openai-completions",
      "aliases": ["gpt"],
      "description": "OpenAI Chat Completions API",
      "base_url": "https://api.openai.com/v1",
      "base_url_envs": ["OPENAI_BASE_URL"],
      "default_model": "gpt-5.4",
      "auth_chain": [
        { "scheme": "bearer", "env": "OPENAI_API_KEY" },
        { "scheme": "oauth" }
      ],
      "compat": {
        "max_tokens_field": "max_completion_tokens",
        "supports_developer_role": true,
        "supports_reasoning_effort": true,
        "supports_xhigh_reasoning": true,
        "supports_prompt_cache_key": true,
        "supports_prompt_cache_retention": true,
        "send_stream_options": true
      },
      "usage_map": {
        "input_ptr": "/prompt_tokens",
        "output_ptr": "/completion_tokens",
        "cache_read_ptr": "/prompt_tokens_details/cached_tokens",
        "reasoning_ptr": "/completion_tokens_details/reasoning_tokens",
        "cached_included_in_input": true
      }
    },
    "openai-responses": {
      "api": "openai-responses",
      "aliases": ["responses", "codex"],
      "description": "OpenAI Stateless Responses API (encrypted reasoning replay, store=false)",
      "base_url": "https://api.openai.com/v1",
      "base_url_envs": ["OPENAI_BASE_URL"],
      "default_model": "gpt-5.4",
      "auth_chain": [
        { "scheme": "bearer", "env": "OPENAI_API_KEY" },
        { "scheme": "oauth" }
      ],
      "compat": {
        "store": false,
        "include_encrypted_reasoning": true,
        "supports_reasoning_effort": true,
        "supports_xhigh_reasoning": true,
        "supports_prompt_cache_key": true,
        "supports_prompt_cache_retention": true,
        "supports_native_web_search": true,
        "supports_native_web_fetch": true
      }
    },
