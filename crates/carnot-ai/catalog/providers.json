    "gemini": {
      "api": "google-generative",
      "aliases": ["google", "google-gemini"],
      "description": "Google Gemini Generative Language API (native SSE + thoughtSignature replay)",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "base_url_envs": ["GOOGLE_GEMINI_BASE_URL", "GEMINI_BASE_URL"],
      "default_model": "gemini-3-pro-preview",
      "auth_chain": [
        { "scheme": "header", "header_name": "x-goog-api-key", "env": "GEMINI_API_KEY" },
        { "scheme": "header", "header_name": "x-goog-api-key", "env": "GOOGLE_API_KEY" },
        { "scheme": "oauth" }
      ],
      "oauth": {
        "flow": "pkce",
        "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
        "token_url": "https://oauth2.googleapis.com/token",
        "client_id_env": "GEMINI_OAUTH_CLIENT_ID",
        "client_secret_env": "GEMINI_OAUTH_CLIENT_SECRET",
        "scopes": [
          "https://www.googleapis.com/auth/generative-language.retriever",
          "https://www.googleapis.com/auth/cloud-platform"
        ],
        "extra_auth_params": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "compat": {
        "thinking_style": "level",
        "include_thoughts": true,
        "sanitize_tool_schemas": false,
        "supports_native_web_search": true,
        "supports_native_web_fetch": true
      }
    },
    "antigravity": {
      "api": "google-cloudcode",
      "aliases": ["google-antigravity", "agy"],
      "description": "Google Cloud Code / Antigravity envelope adapter (daily->prod fallback, schema sanitizer)",
      "base_url": "https://daily-cloudcode-pa.sandbox.googleapis.com",
      "fallback_base_urls": [
        "https://cloudcode-pa.googleapis.com"
      ],
      "base_url_envs": ["ANTIGRAVITY_BASE_URL"],
      "project_env": "ANTIGRAVITY_PROJECT_ID",
      "default_model": "gemini-3-pro-high",
      "auth_chain": [
        { "scheme": "bearer", "env": "ANTIGRAVITY_ACCESS_TOKEN" },
        { "scheme": "bearer", "env": "ANTIGRAVITY_API_KEY" }
      ],
      "headers": {
        "User-Agent": "antigravity/1.15.8 darwin/arm64",
        "X-Goog-Api-Client": "google-cloud-sdk vscode_cloudshelleditor/0.1",
        "Client-Metadata": "{\"ideType\":\"IDE_UNSPECIFIED\",\"platform\":\"PLATFORM_UNSPECIFIED\",\"pluginType\":\"GEMINI\"}"
      },
      "compat": {
        "thinking_style": "level",
        "include_thoughts": true,
        "sanitize_tool_schemas": true,
        "envelope_request_type": "agent",
        "envelope_user_agent": "antigravity",
        "system_preamble": "You are Antigravity, a powerful agentic AI coding assistant designed by the Google DeepMind team."
      }
    },
    "openrouter": {
      "api": "openai-completions",
