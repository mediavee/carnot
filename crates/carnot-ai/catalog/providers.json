{
  "schema_version": 1,
  "providers": {
    "anthropic": {
      "api": "anthropic-messages",
      "aliases": ["claude"],
      "description": "Anthropic Messages API (Claude 4.x / 5.x, direct x-api-key or Bearer gateway)",
      "base_url": "https://api.anthropic.com",
      "base_url_envs": ["ANTHROPIC_BASE_URL"],
      "default_model": "claude-sonnet-5-5",
      "auth_chain": [
        { "scheme": "bearer", "env": "ANTHROPIC_AUTH_TOKEN" },
        { "scheme": "x-api-key", "env": "ANTHROPIC_API_KEY" }
      ],
      "headers": {
        "anthropic-version": "2023-06-01"
      },
      "betas": [],
      "cache_diagnosis_beta": "cache-diagnosis-2026-04-07",
      "native_tool_search": true,
      "compat": {
        "supports_prompt_cache_key": false
      }
    },
    "openai": {
      "api": "openai-completions",
      "aliases": ["gpt"],
      "description": "OpenAI Chat Completions API",
      "base_url": "https://api.openai.com/v1",
      "base_url_envs": ["OPENAI_BASE_URL"],
      "default_model": "gpt-5.4",
      "auth_chain": [
        { "scheme": "bearer", "env": "OPENAI_API_KEY" }
      ],
      "compat": {
        "max_tokens_field": "max_completion_tokens",
        "supports_developer_role": true,
        "supports_reasoning_effort": true,
        "supports_prompt_cache_key": true,
        "send_stream_options": true
      },
      "usage_map": {
        "input_ptr": "/prompt_tokens",
        "output_ptr": "/completion_tokens",
        "cache_read_ptr": "/prompt_tokens_details/cached_tokens",
        "reasoning_ptr": "/completion_tokens_details/reasoning_tokens",
        "cached_included_in_input": true
      }
    },
    "openai-responses": {
      "api": "openai-responses",
      "aliases": ["responses", "codex"],
      "description": "OpenAI Stateless Responses API (encrypted reasoning replay, store=false)",
      "base_url": "https://api.openai.com/v1",
      "base_url_envs": ["OPENAI_BASE_URL"],
      "default_model": "gpt-5.4",
      "auth_chain": [
        { "scheme": "bearer", "env": "OPENAI_API_KEY" }
      ],
      "compat": {
        "store": false,
        "include_encrypted_reasoning": true,
        "supports_reasoning_effort": true,
        "supports_prompt_cache_key": true
      }
    },
    "grok": {
      "api": "openai-completions",
      "aliases": ["xai"],
      "description": "xAI Grok API (OpenAI-compatible endpoint with sticky conversation routing)",
      "base_url": "https://api.x.ai/v1",
      "base_url_envs": ["XAI_BASE_URL", "GROK_BASE_URL"],
      "default_model": "grok-4",
      "auth_chain": [
        { "scheme": "bearer", "env": "XAI_API_KEY" },
        { "scheme": "bearer", "env": "GROK_API_KEY" }
      ],
      "compat": {
        "max_tokens_field": "max_completion_tokens",
        "supports_developer_role": false,
        "supports_reasoning_effort": false,
        "supports_prompt_cache_key": false,
        "session_id_header": "x-grok-conv-id",
        "send_stream_options": true
      },
      "usage_map": {
        "input_ptr": "/prompt_tokens",
        "output_ptr": "/completion_tokens",
        "cache_read_ptr": "/prompt_tokens_details/cached_tokens",
        "reasoning_ptr": "/completion_tokens_details/reasoning_tokens",
        "cached_included_in_input": true
      }
    },
    "muse": {
      "api": "openai-completions",
      "aliases": ["meta", "llama", "muse-code"],
      "description": "Meta / Muse OpenAI-compatible API (override base_url via MUSE_BASE_URL or switch to subprocess-jsonl in ~/.carnot/providers.json)",
      "base_url": "https://api.llama.com/compat/v1",
      "base_url_envs": ["MUSE_BASE_URL", "META_BASE_URL", "LLAMA_BASE_URL"],
      "default_model": "Llama-4-Maverick-17B-128E-Instruct-FP8",
      "auth_chain": [
        { "scheme": "bearer", "env": "MUSE_API_KEY" },
        { "scheme": "bearer", "env": "META_API_KEY" },
        { "scheme": "bearer", "env": "LLAMA_API_KEY" }
      ],
      "compat": {
        "max_tokens_field": "max_completion_tokens",
        "supports_developer_role": false,
        "supports_reasoning_effort": false,
        "supports_prompt_cache_key": false,
        "send_stream_options": true
      },
      "usage_map": {
        "input_ptr": "/prompt_tokens",
        "output_ptr": "/completion_tokens",
        "cache_read_ptr": "/prompt_tokens_details/cached_tokens",
        "reasoning_ptr": "/completion_tokens_details/reasoning_tokens",
        "cached_included_in_input": true
      }
    },
    "gemini": {
      "api": "google-generative",
      "aliases": ["google", "google-gemini"],
      "description": "Google Gemini Generative Language API (native SSE + thoughtSignature replay)",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "base_url_envs": ["GOOGLE_GEMINI_BASE_URL", "GEMINI_BASE_URL"],
      "default_model": "gemini-3-pro-preview",
      "auth_chain": [
        { "scheme": "header", "header_name": "x-goog-api-key", "env": "GEMINI_API_KEY" },
        { "scheme": "header", "header_name": "x-goog-api-key", "env": "GOOGLE_API_KEY" }
      ],
      "compat": {
        "thinking_style": "level",
        "include_thoughts": true,
        "sanitize_tool_schemas": false
      }
    },
    "antigravity": {
      "api": "google-cloudcode",
      "aliases": ["google-antigravity", "agy"],
      "description": "Google Cloud Code / Antigravity envelope adapter (daily->prod fallback, schema sanitizer)",
      "base_url": "https://daily-cloudcode-pa.sandbox.googleapis.com",
      "fallback_base_urls": [
        "https://cloudcode-pa.googleapis.com"
      ],
      "base_url_envs": ["ANTIGRAVITY_BASE_URL"],
      "project_env": "ANTIGRAVITY_PROJECT_ID",
      "default_model": "gemini-3-pro-high",
      "auth_chain": [
        { "scheme": "bearer", "env": "ANTIGRAVITY_ACCESS_TOKEN" },
        { "scheme": "bearer", "env": "ANTIGRAVITY_API_KEY" }
      ],
      "headers": {
        "User-Agent": "antigravity/1.15.8 darwin/arm64",
        "X-Goog-Api-Client": "google-cloud-sdk vscode_cloudshelleditor/0.1",
        "Client-Metadata": "{\"ideType\":\"IDE_UNSPECIFIED\",\"platform\":\"PLATFORM_UNSPECIFIED\",\"pluginType\":\"GEMINI\"}"
      },
      "compat": {
        "thinking_style": "level",
        "include_thoughts": true,
        "sanitize_tool_schemas": true,
        "envelope_request_type": "agent",
        "envelope_user_agent": "antigravity",
        "system_preamble": "You are Antigravity, a powerful agentic AI coding assistant designed by the Google DeepMind team."
      }
    },
    "openrouter": {
      "api": "openai-completions",
      "aliases": ["or"],
      "description": "OpenRouter unified gateway (pin provider.order in body_patch to preserve prompt cache)",
      "base_url": "https://openrouter.ai/api/v1",
      "base_url_envs": ["OPENROUTER_BASE_URL"],
      "default_model": "anthropic/claude-sonnet-4.5",
      "auth_chain": [
        { "scheme": "bearer", "env": "OPENROUTER_API_KEY" }
      ],
      "compat": {
        "max_tokens_field": "max_tokens",
        "supports_developer_role": false,
        "supports_reasoning_effort": false,
        "reasoning_object_effort": true,
        "supports_prompt_cache_key": false,
        "send_stream_options": true
      },
      "usage_map": {
        "input_ptr": "/prompt_tokens",
        "output_ptr": "/completion_tokens",
        "cache_read_ptr": "/prompt_tokens_details/cached_tokens",
        "reasoning_ptr": "/completion_tokens_details/reasoning_tokens",
        "cached_included_in_input": true
      }
    },
    "deepseek": {
      "api": "openai-completions",
      "aliases": ["ds"],
      "description": "DeepSeek API (preserves reasoning_content across tool loops, top-level cache hit tokens)",
      "base_url": "https://api.deepseek.com/v1",
      "base_url_envs": ["DEEPSEEK_BASE_URL"],
      "default_model": "deepseek-reasoner",
      "auth_chain": [
        { "scheme": "bearer", "env": "DEEPSEEK_API_KEY" }
      ],
      "compat": {
        "max_tokens_field": "max_tokens",
        "supports_developer_role": false,
        "supports_reasoning_effort": false,
        "requires_reasoning_content_on_assistant_messages": true,
        "supports_prompt_cache_key": false,
        "send_stream_options": true
      },
      "usage_map": {
        "input_ptr": "/prompt_tokens",
        "output_ptr": "/completion_tokens",
        "cache_read_ptr": "/prompt_cache_hit_tokens",
        "reasoning_ptr": "/completion_tokens_details/reasoning_tokens",
        "cached_included_in_input": true
      }
    },
    "ollama": {
      "api": "openai-completions",
      "aliases": ["local"],
      "description": "Local Ollama OpenAI-compatible server (forces num_ctx=65536 to prevent silent prompt truncation)",
      "base_url": "http://127.0.0.1:11434/v1",
      "base_url_envs": ["OLLAMA_BASE_URL"],
      "default_model": "qwen3-coder",
      "auth_chain": [
        { "scheme": "none" }
      ],
      "compat": {
        "max_tokens_field": "max_tokens",
        "supports_developer_role": false,
        "supports_reasoning_effort": false,
        "supports_prompt_cache_key": false,
        "send_stream_options": true
      },
      "body_patch": {
        "options": { "num_ctx": 65536 }
      }
    },
    "faux": {
      "api": "faux",
      "aliases": ["mock"],
      "description": "Deterministic zero-cost local provider for offline CI & replay testing",
      "base_url": "",
      "default_model": "faux-1",
      "auth_chain": [
        { "scheme": "none" }
      ]
    }
  },
